  "info": {
    "title": "DevPlatform API",
    "description": "",
    "version": "0.1.0-alpha.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "maxLength": 12,
            "description": "新密码为 6–12 字符"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "realName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "homePath": {
            "type": "string"
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "username",
          "realName",
          "roles",
          "homePath",
          "mustChangePassword"
        ]
      },
      "MenuMeta": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "icon"
        ]
      },
      "MenuResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/MenuMeta"
          }
        },
        "required": [
          "name",
          "path",
          "component",
          "meta"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "RecordResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "remark": {
            "type": "string",
            "nullable": true
          },
          "createdBy": {
            "type": "string"
          },
          "version": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "status",
          "remark",
          "createdBy",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "RecordsPageResponse": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordResponse"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "list",
          "total",
          "page",
          "pageSize"
        ]
      },
      "CreateRecordDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ],
            "default": "enabled"
          },
          "remark": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "UpdateRecordDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "remark": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "version"
        ]
      },
      "VersionDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "version"
        ]
      },
      "DeleteRecordResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "number"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "deleted"
        ]
      }
    }
  }
}
