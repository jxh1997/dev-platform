{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "**/.env.*local",
    "**/tsconfig*.json",
    "internal/node-utils/*.json",
    "internal/node-utils/src/**/*.ts",
    "internal/vite-config/*.json",
    "internal/vite-config/src/**/*.ts",
    "scripts/*/src/**/*.ts",
    "scripts/*/src/**/*.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "dist.zip",
        ".vitepress/dist.zip",
        ".vitepress/dist/**"
      ]
    },
    "preview": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:analyze": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@vben/backend-mock#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".nitro/**",
        ".output/**"
      ]
    },
    "test:e2e": {},
    "dev": {
      "dependsOn": [],
      "outputs": [],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "@dev-platform/admin-web#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "dist.zip"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/prepare-release.mjs",
        "$TURBO_ROOT$/deployment/licenses/**",
        "$TURBO_ROOT$/THIRD_PARTY_NOTICES.md",
        "$TURBO_ROOT$/LICENSE.vben",
        "$TURBO_ROOT$/patches/**"
      ]
    }
  }
}
