{
  "name": "dev-platform",
  "version": "0.1.0-alpha.1",
  "private": true,
  "repository": "https://github.com/jxh1997/dev-platform.git",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @dev-platform/admin-web dev",
    "dev:server": "node scripts/dev-server.mjs",
    "build:web": "turbo run build --filter=@dev-platform/admin-web",
    "build:server": "node scripts/build-server.mjs",
    "build": "pnpm build:server && pnpm build:web",
    "start:server": "node dist/apps/server/src/main.js",
    "typecheck": "pnpm --filter @dev-platform/admin-web typecheck && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxfmt --check apps/server packages/backend-modules packages/database scripts/*.ts tests apps/admin-web/src/views/demo apps/admin-web/src/api/core apps/admin-web/src/api/request.ts && oxlint --deny correctness apps/server/src packages/backend-modules/src packages/database/src scripts/*.ts tests",
    "format": "oxfmt --write apps/server packages/backend-modules packages/database scripts/*.ts tests apps/admin-web/src/views/demo apps/admin-web/src/api/core apps/admin-web/src/api/request.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "api:generate": "pnpm build:server && tsx scripts/api.ts",
    "api:check": "pnpm build:server && tsx scripts/api.ts --check",
    "db:migration:run": "tsx packages/database/src/cli.ts run",
    "db:migration:show": "tsx packages/database/src/cli.ts show",
    "db:seed": "tsx packages/database/src/cli.ts seed",
    "admin:init": "tsx packages/database/src/cli.ts admin",
    "test:integration": "pnpm build:server && tsx tests/integration.ts",
    "test:e2e": "playwright test",
    "postinstall": "pnpm -r --if-present run stub",
    "env:init": "node scripts/init-env.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "openapi-typescript": "7.10.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "4.20.6",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "24.22.2",
    "pnpm": "10.33.4"
  },
  "packageManager": "pnpm@10.33.4",
  "description": "DevPlatform \u8f6f\u4ef6\u5f00\u53d1\u4e0e\u5b9a\u5236\u4ea4\u4ed8\u5e95\u5ea7",
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "catalog:"
  }
}
